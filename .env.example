# ─────────────────────────────────────────────────────────────
# mi-agente — plantilla de variables de entorno
#
# Copia este archivo como .env y ajusta los valores.
# El .env real está en .gitignore: NUNCA lo subas al repositorio.
#
#   Copy-Item .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Telegram (opcional — solo si usas el canal Telegram) ──────
TELEGRAM_TOKEN=

# ── Integración con bot_trading (ADR-010) ─────────────────────
# Carpeta raíz del proyecto bot_trading.
# Si no la defines, se usa el valor por defecto de app/config.py.
BOT_TRADING_PATH=C:\Users\lenovo\Proyectos\bot_trading

# Opcionales: se derivan de BOT_TRADING_PATH si los dejas vacíos.
# BOT_TRADING_PYTHON=C:\Users\lenovo\Proyectos\bot_trading\.venv\Scripts\python.exe
# BOT_TRADING_SCRIPT=C:\Users\lenovo\Proyectos\bot_trading\consulta_mercado.py

# Timeout duro del subprocess, en segundos (por defecto: 15).
BOT_TRADING_TIMEOUT=15

# ── Claves de Binance ─────────────────────────────────────────
# ⚠️ NO van aquí. Viven en el .env del proyecto bot_trading.
# mi-agente nunca lee ni loguea estas claves; el subprocess
# simplemente hereda el entorno del sistema.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
